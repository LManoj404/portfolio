# ─────────────────────────────────────────────────────────────
# PORTFOLIO SERVER ENVIRONMENT — NEVER commit real secrets.
# Copy to .env and fill in. The frontend never sees these values:
# the server reads them and performs redirects (WhatsApp) / transport.
# ─────────────────────────────────────────────────────────────

# WhatsApp CTA number (digits only, with country code, no + or spaces).
# Local example for India: 919876543210
WHATSAPP_NUMBER=

# Contact form — if left empty, messages are validated and captured on the
# server (_messages.log) with an honest "email transport not configured" reply.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=manojservices.ai@gmail.com